# ============================================================
# MLOps Automation Webhook Service — environment variables
# Copy this file to .env and fill in the real values.
# NEVER commit the .env file or the private key file.
# ============================================================

# ---- GitHub App credentials ----
# Found at: GitHub → Settings → Developer settings → GitHub Apps → <your app>
GITHUB_APP_ID=123456

# Absolute path to the RSA private key (.pem) downloaded from the GitHub App page.
# Keep this file outside any git-tracked directory, or ensure .gitignore covers *.pem
GITHUB_PRIVATE_KEY_PATH=D:\MLOps-Automation\webhook\private-key.pem

# The webhook secret you set when configuring the GitHub App webhook.
GITHUB_WEBHOOK_SECRET=replace_with_your_webhook_secret

# ---- Automation repository ----
# The GitHub repository that hosts this automation framework.
# Format: owner/repo  (no https://, no trailing slash)
MLOPS_AUTOMATION_REPO=YourOrg/MLOps-Automation

# ---- Server settings (optional) ----
HOST=0.0.0.0
PORT=8080
